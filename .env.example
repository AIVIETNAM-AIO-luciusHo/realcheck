# Biến của một lần deploy Compose; chép thành .env cạnh docker-compose.yml (.env không commit).
# Hướng dẫn: docs/deploy.md.

# Tag image API/UI, đặt bằng commit ngắn đang deploy (git rev-parse --short HEAD) để rollback được.
REALCHECK_TAG=latest

# File model trong models/, cần file .sha256 cùng tên bên cạnh.
REALCHECK_MODEL_FILE=clip_probe_e571.joblib

# Cổng gateway trên máy chủ.
REALCHECK_HTTP_PORT=80
