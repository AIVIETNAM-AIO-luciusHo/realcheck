{
  "uid": "realcheck-api",
  "title": "RealCheck API",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Request/s theo route và nhóm status",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "realcheck-prom"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (route, status_class) (rate(realcheck_requests_total[5m]))",
          "legendFormat": "{{route}} {{status_class}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "p95 độ trễ theo route (s)",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "realcheck-prom"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, route) (rate(realcheck_request_duration_seconds_bucket[5m])))",
          "legendFormat": "{{route}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Lỗi API theo mã/s",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "realcheck-prom"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (code) (rate(realcheck_api_errors_total[5m]))",
          "legendFormat": "{{code}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Slot suy luận đang bận",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "realcheck-prom"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "realcheck_inference_slots_in_use",
          "legendFormat": ""
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Model sẵn sàng",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "realcheck-prom"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "realcheck_model_ready",
          "legendFormat": ""
        }
      ]
    }
  ]
}